# Copy to ~/toc-backend/.env on the server and fill in. Never commit the real file.
APP_NAME="TOC Construction API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.toc.certicode.net

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=https://toc.certicode.net,https://admin.toc.certicode.net

JWT_SECRET=

MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TOC Construction"

SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
