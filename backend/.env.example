APP_NAME="TOC Construction API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toc_construction
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# In production, set this to your actual frontend domain(s), e.g.:
# CORS_ALLOWED_ORIGINS=https://tocconstruction.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=database
